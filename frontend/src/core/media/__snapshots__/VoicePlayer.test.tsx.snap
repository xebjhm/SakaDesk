exports[`VoicePlayer component > Snapshots > should match snapshot for compact variant 1`] = `
<div
  class="bg-sunken rounded-lg p-3 min-w-[300px] outline-none focus:ring-2"
  style="--ring-color: color-mix(in srgb, var(--ds-accent) 50%, transparent);"
  tabindex="0"
>
  <audio
    preload="metadata"
    src="/api/media/voice.m4a"
  />
  <div
    class="mb-3"
  >
    <div
      class="relative h-1 bg-control-off rounded-full overflow-hidden"
    >
      <div
        class="absolute inset-y-0 left-0 rounded-full"
        style="width: 0%; background-color: var(--ds-accent);"
      />
      <input
        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
        max="100"
        min="0"
        type="range"
        value="0"
      />
    </div>
  </div>
  <div
    class="flex items-center"
  >
    <div
      class="flex-1 flex items-center"
    >
      <div
        class="relative flex items-center"
      >
        <button
          class="p-1.5 hover:bg-sunken hover:brightness-94 rounded-full transition-colors"
          title="Mute (M)"
          type="button"
        >
          <svg
            class="w-4 h-4 text-secondary"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <polygon
              points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"
            />
            <path
              d="M15.54 8.46a5 5 0 0 1 0 7.07"
            />
            <path
              d="M19.07 4.93a10 10 0 0 1 0 14.14"
            />
          </svg>
        </button>
        <div
          class="flex items-center overflow-hidden transition-all duration-200 ease-out w-0 ml-0 opacity-0"
        >
          <input
            class="w-full h-1 rounded-full appearance-none cursor-pointer"
            max="1"
            min="0"
            step="0.01"
            style="accent-color: var(--ds-accent); background: linear-gradient(to right, var(--ds-accent) 50%, var(--ds-border-strong) 50%);"
            type="range"
            value="0.5"
          />
        </div>
      </div>
    </div>
    <button
      class="w-10 h-10 rounded-full shadow-pill flex items-center justify-center transition-colors shrink-0 hover:brightness-90"
      style="background-color: var(--ds-accent);"
      type="button"
    >
      <svg
        class="w-5 h-5 text-inverse fill-current ml-0.5"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <polygon
          points="5 3 19 12 5 21 5 3"
        />
      </svg>
    </button>
    <div
      class="flex-1 flex items-center justify-end gap-1"
    >
      <div
        class="text-xs text-secondary whitespace-nowrap"
      >
        0:00
         / 
        0:00
      </div>
      <button
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label="More options"
        class="p-1.5 hover:bg-sunken hover:brightness-94 rounded-full transition-colors"
        type="button"
      >
        <svg
          class="w-4 h-4 text-secondary"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="1"
          />
          <circle
            cx="12"
            cy="5"
            r="1"
          />
          <circle
            cx="12"
            cy="19"
            r="1"
          />
        </svg>
      </button>
    </div>
  </div>
</div>
`;

